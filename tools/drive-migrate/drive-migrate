    pu.add_argument("--tag", action="append"); pu.add_argument("--dry-run", action="store_true"); pu.add_argument("--source", default="gdrive")
    pu.set_defaults(func=cmd_push)
    ps = sub.add_parser("status"); ps.set_defaults(func=cmd_status)
    a = p.parse_args()
