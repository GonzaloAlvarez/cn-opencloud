# cn-opencloud — copy to .env (gitignored). The real .env is Kauket-managed:
#   kauket get kaiser.cn_opencloud_env
# Comments must stay on their own lines (docker env files have no inline #).

# ── Tailnet sidecar (ts-drive, tag:svc) ─────────────────────────────────────
# Pre-auth key minted on the VPS (numeric user id, one-shot, short-lived):
#   ssh hs.gn.al 'docker exec cloudnet-headscale-1 headscale preauthkeys create --user 2 --tags tag:svc --expiration 1h'
DRIVE_AUTHKEY=
HEADSCALE_DOMAIN=hs.gn.al
INFRA_VPS_TAILNET_IP=100.64.0.1

# ── Domains ─────────────────────────────────────────────────────────────────
LAN_DOMAIN=kaiser.lan
LAB_DOMAIN=lab.gn.al
TAILNET_DOMAIN=ts.gn.al

# ── Ops ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=
TIMEZONE=America/Los_Angeles

# ── OpenCloud ───────────────────────────────────────────────────────────────
# Local `admin` account password — used ONLY on the very first start (the
# built-in idm user store is created then; later edits are ignored). Break-glass
# together with PROXY_ENABLE_BASIC_AUTH during an Authentik outage.
# openssl rand -base64 18
OC_ADMIN_PASSWORD=
# PosixFS root on kaiser's SSD (plain browsable tree, owner 1000:1000, 0700).
# NOT the raidnas NFS export: PosixFS needs extended attributes and inotify,
# which NFSv3 does not provide.
OC_DATA_DIR=/home/gonzalo/docker/cn-opencloud/data
OC_LOG_LEVEL=info
# `jwt` verifies Authentik's RS256 access tokens against its JWKS; set `none`
# only if verification fails and record why in the README.
OC_OIDC_VERIFY_METHOD=jwt
# From-header for OpenCloud's own notification mails
OC_SMTP_SENDER=OpenCloud <drive@gon.al>

# ── Backup — restic → raidnas NFS repo + S3 copy (scripts/backup.sh) ────────
# RETAINED material: losing it makes every snapshot in BOTH repos unreadable.
# Mint once (openssl rand -base64 32), never rotate.
RESTIC_PASSWORD=
BACKUP_S3_BUCKET=cloudnet-lab-storage
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=us-east-2

# ── SMTP — shared homelab Mailgun (same values as other cn-* stacks) ────────
SMTP_HOST=
SMTP_FROM=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL=
